{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pit.app/skills/design-analyst/output-schema.json",
  "title": "pit design-analyst output",
  "description": "Contract for the design-analyst skill. The analysis tasks (A/B) return a DesignDoc; the routing task (C) returns a RoutingResult. The DesignDoc maps 1:1 onto pit's renderer DesignDoc type.",
  "oneOf": [{ "$ref": "#/$defs/DesignDoc" }, { "$ref": "#/$defs/RoutingResult" }],
  "$defs": {
    "DesignDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "theme", "description", "palette", "fonts", "tags"],
      "properties": {
        "url": { "type": "string", "description": "Source URL (site task only)." },
        "title": { "type": "string" },
        "theme": { "type": "string", "description": "Section 1 — visual theme & atmosphere, 1–2 sentences." },
        "description": { "type": "string", "description": "What it is and what it's a good reference for." },
        "pages": {
          "type": "array",
          "description": "Captured pages (site task). Omit status/screenshot — pit fills those.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "description": "Path segment, e.g. 'method/build'." },
              "summary": { "type": "string" }
            }
          }
        },
        "palette": {
          "type": "array",
          "description": "Section 2 — colors by semantic role; pct sums to ≈ 100.",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hex", "role"],
            "properties": {
              "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}$", "description": "Uppercase hex." },
              "role": {
                "type": "string",
                "description": "Semantic role: ink, paper, primary, accent, accent-2, muted, danger, success, tint, surface, dominant, shadow, deep, highlight."
              },
              "pct": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          }
        },
        "fonts": {
          "type": "array",
          "description": "Section 3 — typography hierarchy.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sample"],
            "properties": {
              "role": { "type": "string", "enum": ["display", "heading", "body", "caption", "mono", "accent"] },
              "name": { "type": "string", "description": "Named face if certain, else a classification." },
              "sample": { "type": "string", "description": "Short specimen, e.g. 'Aa' or 'Display 64'." },
              "weight": { "type": "string" },
              "size": { "type": "string", "description": "'64px / 0.95' (size / line-height)." }
            }
          }
        },
        "components": {
          "type": "array",
          "description": "Section 4 — recurring components, token-encoded.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "count", "tokens"],
            "properties": {
              "name": { "type": "string" },
              "count": { "type": "integer", "minimum": 1 },
              "tokens": { "type": "string", "description": "'r:8 · h:36 · px:16 · ink/paper · hover:lift'." }
            }
          }
        },
        "ia": {
          "type": "array",
          "description": "Section 5 — information architecture tree.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lvl", "label"],
            "properties": {
              "lvl": { "type": "integer", "minimum": 0, "description": "Indentation depth." },
              "label": { "type": "string" },
              "meta": { "type": "string" }
            }
          }
        },
        "layoutNote": {
          "type": "string",
          "description": "Grid summary: '12-col · 1216 max · gutter 24 · asymmetric (cols 2–8 body)'."
        },
        "motion": {
          "type": "array",
          "description": "Section 6 — depth/elevation & motion.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "easing", "dur", "bar"],
            "properties": {
              "type": { "type": "string" },
              "easing": { "type": "string" },
              "dur": { "type": "string" },
              "bar": { "type": "number", "minimum": 0, "maximum": 100, "description": "Relative intensity for the UI meter." }
            }
          }
        },
        "dos": { "type": "array", "items": { "type": "string" }, "description": "Section 7 — non-negotiable rules." },
        "donts": { "type": "array", "items": { "type": "string" }, "description": "Section 7 — anti-patterns." },
        "responsive": { "type": "string", "description": "Section 8 — breakpoints, touch targets, collapse." },
        "agentPrompt": { "type": "string", "description": "Section 9 — ready-to-paste reproduction prompt." },
        "a11y": {
          "type": "array",
          "description": "Accessibility scan.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "grade", "detail"],
            "properties": {
              "label": { "type": "string" },
              "grade": { "type": "string", "enum": ["A", "B", "C"] },
              "detail": { "type": "string" }
            }
          }
        },
        "tags": {
          "type": "array",
          "description": "Lowercase hyphenated descriptors driving routing.",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "mood": { "type": "array", "items": { "type": "string" }, "description": "Image task — affective descriptors." },
        "materials": { "type": "array", "items": { "type": "string" }, "description": "Image task — material reads." },
        "style": { "type": "array", "items": { "type": "string" }, "description": "Image task — visual style." }
      }
    },
    "RoutingResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suggestions", "best"],
      "properties": {
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["collectionId", "confidence", "reason"],
            "properties": {
              "collectionId": { "type": "string" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
              "reason": { "type": "string" }
            }
          }
        },
        "best": { "type": "string", "description": "Highest-confidence collection id, or 'inbox' if below threshold." }
      }
    }
  }
}

{
  "name": "pit-cf-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker backing pit.ink share links: D1 metadata + R2 blob storage.",
  "scripts": {
    "dev": "wrangler dev",
    "release": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:apply:local": "wrangler d1 execute pit-shares-db --local --file=./schema.sql",
    "db:apply:remote": "wrangler d1 execute pit-shares-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250523.0",
    "typescript": "^5.4.0"
  }
}
